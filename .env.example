# unifi-mcp — Konfigurationsvorlage
#
# Verwendung lokal:
#   cp .env.example .env  und in .env ausfuellen
#
# Produktion (Compose/K8s): gleiche Namen, ueber env_file bzw.
# ConfigMap + Secret liefern. Echte Umgebungsvariablen
# ueberschreiben Werte aus .env.
#
# .env selbst kommt NIEMALS ins Repo (siehe .gitignore).

# --- UniFi Network ---
# Base URL des Cloud Gateways (inkl. Scheme)
UNIFI_BASE_URL=https://172.26.x.x
# API-Key des Gateways (MVP: read-only/minimal privilegiert)
UNIFI_API_KEY=
# Site-ID (leer = Default-Site)
UNIFI_SITE_ID=
# TLS-Modus:
#   strict        — Verifikation gegen UNIFI_CA_BUNDLE
#   extract-once — Gateway-Cert beim Start extrahieren und fuer die Session nutzen
#   insecure     — Verifikation aus (nur lokale Entwicklung!)
UNIFI_TLS_MODE=extract-once
# Nur fuer strict: Pfad zum CA-Bundle, das das Gateway-Zertifikat verifiziert
UNIFI_CA_BUNDLE=certs/gateway.crt
UNIFI_TIMEOUT_SECONDS=15
UNIFI_CONNECT_TIMEOUT_SECONDS=5
UNIFI_MAX_RETRIES=2

# --- MCP-Server ---
# Bearer-Token fuer LiteLLM/Client-Auth (z.B. `openssl rand -hex 32`)
MCP_AUTH_TOKEN=
MCP_BIND_HOST=0.0.0.0
MCP_BIND_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Feature-Flags (MVP: alle aus) ---
ENABLE_WRITE_TOOLS=false
ENABLE_ACTION_TOOLS=false
ENABLE_DELETE_TOOLS=false

# --- Limits ---
MAX_LIST_ITEMS=200
MAX_TOOL_RESPONSE_BYTES=262144
