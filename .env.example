# unifi-mcp — Konfigurationsvorlage
#
# Verwendung lokal:
#   cp .env.example .env  und in .env ausfuellen
#
# Produktion (Compose/K8s): gleiche Namen, ueber env_file bzw.
# ConfigMap + Secret liefern. Echte Umgebungsvariablen
# ueberschreiben Werte aus .env.
#
# .env selbst kommt NIEMALS ins Repo (siehe .gitignore).

# --- UniFi Network ---
# Base URL des Cloud Gateways (inkl. Scheme)
UNIFI_BASE_URL=https://172.26.x.x
# API-Key des Gateways (MVP: read-only/minimal privilegiert)
UNIFI_API_KEY=
# Site-ID (leer = Default-Site)
UNIFI_SITE_ID=
# TLS-Modus:
#   strict        — Verifikation gegen UNIFI_CA_BUNDLE
#   extract-once — Gateway-Cert beim Start extrahieren und fuer die Session nutzen
#   insecure     — Verifikation aus (nur lokale Entwicklung!)
UNIFI_TLS_MODE=extract-once
# Nur fuer strict: Pfad zum CA-Bundle, das das Gateway-Zertifikat verifiziert
UNIFI_CA_BUNDLE=certs/gateway.crt
# Zeitlimits pro Request-Phase (Sekunden): read / connect / pool.
UNIFI_TIMEOUT_SECONDS=15
UNIFI_CONNECT_TIMEOUT_SECONDS=5
UNIFI_POOL_TIMEOUT_SECONDS=5
# Wiederholungen pro Read-Request nach dem ersten Versuch (0 = keine). Der
# Default 1 hält den Worst-Case eines Reads unter dem Tool-Call-Budget.
UNIFI_MAX_RETRIES=1
# Retry-Rückzug: exponentiell mit vollem Jitter — Basis und Obergrenze je Stufe (s).
UNIFI_RETRY_BACKOFF_BASE_SECONDS=0.5
UNIFI_RETRY_BACKOFF_CAP_SECONDS=2.0
# Max. parallel laufende Gateway-Requests pro Client (sättigt nicht den Pool).
UNIFI_MAX_CONCURRENT_REQUESTS=8
# Gesamtbudget pro MCP-Tool-Call (Sekunden): Deckel für alle Request-Versuche,
# Backoff- und Pool-Wartezeit eines Calls. Muss strikt unter dem externen
# MCP-Timeout (60 s, LiteLLM) bleiben — vgl. docs/reference/budget-and-retry.md.
UNIFI_TOOL_CALL_BUDGET_SECONDS=45

# --- MCP-Server ---
# Bearer-Token fuer LiteLLM/Client-Auth (z.B. `openssl rand -hex 32`)
MCP_AUTH_TOKEN=
MCP_BIND_HOST=0.0.0.0
MCP_BIND_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Feature-Flags (MVP: alle aus) ---
ENABLE_WRITE_TOOLS=false
ENABLE_ACTION_TOOLS=false
ENABLE_DELETE_TOOLS=false

# --- Limits ---
MAX_LIST_ITEMS=200
MAX_TOOL_RESPONSE_BYTES=262144

# --- Write-Audit-Log (Design §27, ab WP-14 relevant) ---
# Leer (Default) = nur stdout (strukturiertes Logging).
# Pfad gesetzt (z.B. ein Host-Mount im Container) = zusätzlich wird jeder
# Write-Versuch (erfolgreich UND abgelehnt) als JSONL-Event in diese Datei
# appendet, je Event eine Zeile. Das Parent-Directory muss existieren;
# bei Open-/Write-Fehlern wird gewarnt und auf stdout gefallbackt.
AUDIT_LOG_PATH=
